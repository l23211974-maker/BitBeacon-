{
  "poll_interval": "5s",
  "serial_port": "COM10",
  "baud_rate": 115200,
  "services": [
    { "type": "http", "name": "HTTP-OK (testserver)",   "target": "http://127.0.0.1:8090/health", "timeout_seconds": 2 },
    { "type": "http", "name": "HTTP-ERROR (sin nada ahi)", "target": "http://127.0.0.1:9999/health", "timeout_seconds": 2 },
    { "type": "tcp",  "name": "TCP-OK (testserver)",    "target": "127.0.0.1:9090", "timeout_seconds": 2 },
    { "type": "tcp",  "name": "TCP-ERROR (sin nada ahi)", "target": "127.0.0.1:9999", "timeout_seconds": 2 },
    { "type": "ping", "name": "PING-OK (localhost)",    "target": "127.0.0.1", "timeout_seconds": 2 }
  ]
}
